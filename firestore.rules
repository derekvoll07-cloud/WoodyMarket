rules_version = '2';
// Woody Polymarket security rules.
// Replace YOUR_USERNAME below with the same username you put in site/config.js (lowercase).
// Keep the @woody.example.com part: that's how usernames are stored behind the scenes.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn() && request.auth.token.email == 'derekv@woody.example.com';
    }
    // New accounts start as 'pending'. Only approved members (and you) can see or use the board.
    function memberDoc(uid) { return /databases/$(database)/documents/members/$(uid); }
    function isMember() {
      return isOwner() || (signedIn() && exists(memberDoc(request.auth.uid))
        && get(memberDoc(request.auth.uid)).data.status == 'approved');
    }
    function modsDoc() { return /databases/$(database)/documents/admin/mods; }
    function modIds() { return exists(modsDoc()) ? get(modsDoc()).data.ids : []; }
    function isMod() { return isOwner() || (isMember() && request.auth.uid in modIds()); }
    function approvalOff() {
      return exists(/databases/$(database)/documents/admin/config)
        && get(/databases/$(database)/documents/admin/config).data.requireApproval == false;
    }

    // Who's allowed on the board. Players can read their own record, and ask to join.
    match /members/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isMember();
      allow create: if isOwner() || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['status', 'name', 'requestedAt'])
      );
      // You decide on anyone. Moderators decide on players, but not on themselves,
      // other moderators or you.
      allow update: if isOwner() || (
        isMod() && request.auth.uid != uid
        && resource.data.get('owner', false) != true
        && !(uid in modIds())
        && request.resource.data.status in ['approved', 'rejected', 'removed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy'])
      );
      allow delete: if isOwner();
    }

    // House settings and the moderator list: members can read, only you can change.
    match /admin/{docId} {
      allow read: if isMember();
      allow write: if isOwner();
    }

    // Each player's display name and photo. Players write only their own.
    match /profiles/{uid} {
      allow read: if isMember() || (signedIn() && request.auth.uid == uid);
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Each player's trades, comments, disputes and top-ups. Players write only their own.
    match /bets/{uid} {
      allow read: if isMember();
      allow write: if isMember() && request.auth.uid == uid;
    }

    match /markets/{marketId} {
      allow read: if isMember();

      // Moderators can create anything (including example markets).
      // Players create markets in their own name, in review unless you've turned approval off.
      allow create: if isMod() || (
        isMember()
        && request.resource.data.creator == request.auth.uid
        && (request.resource.data.status == 'pending'
            || (request.resource.data.status == 'open' && approvalOff()))
      );

      // Moderators can approve, reject, resolve and change results.
      // A creator can only report the result of their own market after it closes.
      allow update: if isMod() || (
        isMember()
        && resource.data.creator == request.auth.uid
        && resource.data.status == 'open'
        && request.time.toMillis() >= resource.data.closeAt
        && request.resource.data.status == 'resolved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolution'])
      );

      allow delete: if isOwner();
    }
  }
}
